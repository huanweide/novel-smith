# Novel Smith 环境变量模板
# 用法：复制本文件为 .env（命令：cp .env.example .env），一般无需手改。.env 已被 .gitignore 忽略，不会上传。

# ── 数据库（零配置本地 SQLite 文件库，无需 Docker / 外部 Postgres）──
# clone 后开箱即用：npm run dev:db 会自动建库文件（./data/novelforge.db），不必安装任何数据库。
DATABASE_URL="file:./data/novelforge.db"

# ── LLM 配置（环境变量方式，优先级低于应用内「设置」页填的 Key）──
# 不填也能跑，可在网页 ⚙️ 设置 里填；这里填了则作为默认值。
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# ── 访问控制（v3.1.115 起内置，默认最安全，一般不用动）──
# 默认：全部 /api/* 只接受来自本机或局域网的请求，公网来源一律 403。
# 确需对外提供服务时设为 true（请自行再加一层反向代理鉴权）。
# ALLOW_PUBLIC=true

# ── 可选调优 ──
MAX_TOKENS_PER_REQUEST=4096
CONTEXT_WINDOW_SIZE=65536
