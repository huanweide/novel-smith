# Novel Forge 环境变量模板
# 用法：复制本文件为 .env（命令：cp .env.example .env），再填值。.env 已被 .gitignore 忽略，不会上传。

# ── 数据库（Docker 默认，先 docker compose up -d 起库）──
DATABASE_URL="postgresql://novelforge:novelforge123@127.0.0.1:5432/novelforge"

# ── LLM 配置（环境变量方式，优先级低于应用内「设置」页填的 Key）──
# 不填也能跑，可在网页 ⚙️ 设置 里填；这里填了则作为默认值。
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# ── 可选调优 ──
MAX_TOKENS_PER_REQUEST=4096
CONTEXT_WINDOW_SIZE=65536
