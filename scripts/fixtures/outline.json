  "loreEntries": [
    {
      "title": "青冥宗",
      "category": "faction",
      "keys": [
        "青冥宗"
      ],
      "content": "青冥宗——天下第一剑宗，立于云巅九千阶之上。宗内以剑入道，分内门七峰。镇派绝学「青冥剑诀」需废脉之体方可练至大成。与玄霜阁、焚天殿鼎足而立，却因龙陨之地暗生嫌隙。",
      "insertionOrder": 85
    },
    {
      "title": "玄霜阁",
      "category": "faction",
      "keys": [
        "玄霜阁"
      ],
      "content": "玄霜阁：北境冰原上的术法宗门，擅冰封与咒术。阁中以「霜魂」为凭，弟子需剜心献祭方得传承。少阁主顾衍执掌实务，表面与青冥宗交好，暗中图谋龙陨。",
      "insertionOrder": 85
    },
    {
      "title": "焚天殿",
      "category": "faction",
      "keys": [
        "焚天殿"
      ],
      "content": "焚天殿——南荒火修云集之地，崇奉焚天古神。殿中圣女叶红妆权倾一时，焚天殿与青冥宗有血海深仇（沈厌离满门即灭于其手）。焚天殿手握「焚天令」，可号令南荒百部。",
      "insertionOrder": 85
    },
    {
      "title": "幽都",
      "category": "faction",
      "keys": [
        "幽都"
      ],
      "content": "幽都：死者之国，位于人间与冥界夹缝。由「幽都之主」统辖，常年笼于灰雾。白帝当年一剑封其门，如今封印渐松，幽都厉鬼时有逸出。谢长安曾独闯幽都夺回赤羽族圣物。",
      "insertionOrder": 85
    },
    {
      "title": "万宝商会",
      "category": "faction",
      "keys": [
        "万宝商会"
      ],
      "content": "万宝商会——横跨人妖两族的巨贾联盟，明面做生意，暗面贩卖情报与异宝。商会垂涎阿萝的灵视之体，多次派人潜入青冥宗。墨九卿的情报网正与万宝商会相互渗透。",
      "insertionOrder": 85
    },
    {
      "title": "赤羽族",
      "category": "faction",
      "keys": [
        "赤羽族"
      ],
      "content": "·赤羽族：生于南境火山带的异族，化为人形则额生赤羽。全族信奉火神，圣物「赤羽心」被幽都所掳，少主谢长安立志夺回。赤羽族与青冥宗偶有往来，却因人妖世仇难获信任。",
      "insertionOrder": 85
    },
    {
      "title": "龙陨之地",
      "category": "geography",
      "keys": [
        "龙陨之地"
      ],
      "content": "龙陨之地——位于两界山腹地，每三百年开启一次，开启时天现血月、灵气倒灌。深处藏有白帝遗骸所化龙骨，是全书因果的枢纽。",
      "insertionOrder": 60
    },
    {
      "title": "青冥剑诀",
      "category": "magic_system",
      "keys": [
        "青冥剑诀"
      ],
      "content": "青冥剑诀——青冥宗镇派绝学，共九重。第九重「斩因果」需以自身一段记忆为薪，唯废脉之体可练至大成。",
      "insertionOrder": 85
    },
    {
      "title": "三百年前的内乱",
      "category": "history",
      "keys": [
        "三百年前的内乱"
      ],
      "content": "三百年前的内乱——青冥宗一夜血流成河，宗主失踪、老祖坐化，死的不只是弟子，还有一段被刻意抹去的真相。玄霜冰原之下埋着当年的证物。",
      "insertionOrder": 60
    },
    {
      "title": "焚天令",
      "category": "item",
      "keys": [
        "焚天令"
      ],
      "content": "焚天令——焚天殿镇殿之宝，可号令南荒百部。叶红妆与顾衍为争夺此物结下宿怨。",
      "insertionOrder": 60
    },
    {
      "title": "龙陨封印",
      "category": "law",
      "keys": [
        "龙陨封印"
      ],
      "content": "龙陨封印——以白帝神魂为锁，林惊蛰所得龙骨正是那把钥匙。封印渐松，幽都厉鬼时有逸出。",
      "insertionOrder": 60
    },
    {
      "title": "妖族",
      "category": "creature",
      "keys": [
        "妖族"
      ],
      "content": "妖族——与人族并立于世，化形者须渡天劫。人妖两族世仇绵延千年，赤羽族便是妖族一支。",
      "insertionOrder": 60
    }
  ],
  "plotOutline": "讲述废脉少年林惊蛰于龙陨之地得白帝遗骸，在师父苏砚含恨而终后，联合沈厌离、南柯、阿萝等人揭开三百年前青冥宗内乱真相，周旋于青冥宗、玄霜阁、焚天殿、幽都、万宝商会与赤羽族六方势力之间，最终重启龙陨封印、了断因果的故事。基调偏热血与虐恋交织，暗线权谋。",
