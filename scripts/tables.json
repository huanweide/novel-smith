[{"id":"65e56bcc-9de6-4ea3-9bf3-17e758945dd5","projectId":"757834b6-8100-41f7-8699-88587276cac0","name":"人物表","key":"characters","note":"","category":"person","marker":"[ACU-757834b6-8100-41f7-8699-88587276cac0]","columns":[{"key":"名称","type":"text","label":"名称"},{"key":"身份","type":"text","label":"身份"},{"key":"描述","type":"text","label":"描述"}],"rows":[{"_ts":"2026-08-04T07:19:55.623Z","_src":"ch1:batchmanual","row_id":1,"名称":"林惊羽","描述":"倒提长剑走到断魂崖边缘，对苏沐雪说‘留在这’、‘若一炷香后我没上来，你回镇上，把那封信交给秦掌柜’，随后踏出崖边，身影没入粘稠的雾海。"},{"_ts":"2026-08-04T07:19:55.623Z","_src":"ch1:batchmanual","row_id":2,"名称":"苏沐雪","描述":"没有跟上去，蹲在尸体旁翻开领口摸出铁铸令牌，认出是‘黑齿寨的暗哨’。在崖边石缝中擦亮火折子插稳，安静等待。"}],"createdAt":"2026-08-04T07:08:45.538Z","updatedAt":"2026-08-04T07:19:55.705Z"},{"id":"f30c4170-ad00-4678-b6b9-77c557700038","projectId":"757834b6-8100-41f7-8699-88587276cac0","name":"地点表","key":"places","note":"","category":"geo","marker":"[ACU-757834b6-8100-41f7-8699-88587276cac0]","columns":[{"key":"名称","type":"text","label":"名称"},{"key":"描述","type":"text","label":"描述"}],"rows":[{"_ts":"2026-08-04T07:19:55.623Z","_src":"ch1:batchmanual","row_id":1,"名称":"青石镇","描述":"其外有断魂崖。镇上有个瞎了一只眼的老猎户，曾警告后生莫沾断魂崖底下的东西。"},{"_ts":"2026-08-04T07:19:55.623Z","_src":"ch1:batchmanual","row_id":2,"名称":"断魂崖","描述":"崖下翻涌的云雾。崖口裂口处碎石上嵌着铁青色断鳞，三具尸体横在不远处。崖下三十丈偏右侧石壁有凹陷，雾海深处有极慢极沉的呼吸声。"}],"createdAt":"2026-08-04T07:08:45.615Z","updatedAt":"2026-08-04T07:19:55.707Z"}]