/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database (local only)
# v3.1.54：整个 data/ 目录一律不入库 —— 里面存着用户填的 LLM API Key、
# 全部小说正文与设定，且 *.db 规则漏掉了备份文件（如 novelforge.db.bak-20260830），
# 一旦 commit 就是凭据泄露 + 数据外泄。用目录级规则一次堵死。
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# runtime state (auto-generated, local only)
/.runtime/

# === 凭据安全补充（强制）===
.env
.env.*
!.env.example
!.env.template

*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.priv
id_rsa
id_ecdsa
id_ed25519
id_dsa
