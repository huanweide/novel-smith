generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 项目 (Project) ────────────────────────────────────────

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String   @default("")
  genre          String[]               // 类型标签
  targetWordCount Int     @default(100000)
  synopsis       String   @default("")  // 主线总纲
  toneKeywords   String[] @default([])  // 基调关键词
  povCharacterId String?                 // 当前视角主角

  globalPrompt String @default("")  // 世界书+风格卡缓存摘要——扩展角色时直接用
  authorNote   String @default("")  // 作者指令——持久化，所有生成端点统一读取
  // LLM配置 (JSON存储)
  llmConfig Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  characters    CharacterCard[]
  lorebookEntries LorebookEntry[]
  storyNodes    StoryNode[]
  storyBranches StoryBranch[]
  chapterSummaries ChapterSummary[]
  storyBeats    StoryBeat[]
  storylines    Storyline[]
  styleCards    StyleCard[]
  rules         Rule[]
  pendingCommitments PendingCommitment[]
}

// ─── 人物卡 (Character Card) ───────────────────────────────

model CharacterCard {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  aliases  String[] @default([])
  age      String   @default("未知")
  gender   String   @default("未知")
  role     String   @default("supporting") // CharacterRole枚举

  // 结构化数据 (JSON存储)
  appearance      Json @default("{}")    // CharacterAppearance
  personality     Json @default("[]")    // 结构化性格: {dominant, drive, contradiction, habits, socialMask} 或旧格式 string[]
  dialogueStyle   Json @default("{}")    // DialogueStyle
  background      String @default("")
  quickImportContent String @default("")  // 快速导入原文（不做AI分析，直接抄写）
  abilities       String[] @default([])  // 能力/技能
  hiddenMotives   String[] @default([])
  relationships   Json @default("[]")    // CharacterRelationship[]

  timeline        Json @default("[]")     // TimelineEvent[] 经历时间线
  currentStatus   String @default("alive") // CharacterStatus
  arcProgress     String @default("")
  tags            String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─── 世界书词条 (Lorebook Entry) ───────────────────────────

model LorebookEntry {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title           String
  category        String @default("custom") // LoreCategory
  keys            String[]                  // 触发关键词
  content         String                    // 设定内容 ≤200 Token
  insertionOrder  Int @default(50)          // 0-100
  enabled         Boolean @default(true)
  parentId        String?                   // 父词条
  relatedEntryIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([enabled])
}

// ─── 故事节点 (Story Node) —— 章节树 ──────────────────────

model StoryNode {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?        // 父节点（根节点=null）
  type     String         // StoryNodeType: volume/chapter/section/scene
  title    String
  order    Int @default(0)
  status   String @default("outline_only") // ContentStatus

  // 内容
  outline   String?      // 大纲
  content   String?      // 正文
  wordCount Int @default(0)

  // 分支
  branchId           String?
  isMainBranch       Boolean @default(true)
  previousVersionId  String?

  // 元数据
  activeCharacters  String[] @default([])
  activeLoreIds     String[] @default([])
  coreConflict      String?
  settingDescription String?
  notes             String?

  // 审校
  reviewLogs    Json @default("[]")       // ReviewLog[]
  revisionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 自引用
  parent   StoryNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children StoryNode[] @relation("NodeTree")

  // 分支关联
  branch StoryBranch? @relation(fields: [branchId], references: [id])

  @@index([projectId])
  @@index([parentId])
  @@index([branchId])
}

// ─── 故事分支 (Story Branch) ───────────────────────────────

model StoryBranch {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  description     String @default("")
  parentBranchId  String?
  forkPointNodeId String
  isActive        Boolean @default(true)

  nodes StoryNode[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── 章节摘要 (Chapter Summary) —— 中期记忆 ───────────────

model ChapterSummary {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapterId    String
  chapterTitle String
  summary      String                    // AI压缩摘要 ≤200 Token
  keyEvents    String[] @default([])
  characterStates Json @default("[]")    // CharacterStateSnapshot[]
  eventImportances Json @default("{\"sTier\":[],\"aTier\":[],\"bTier\":[],\"cTier\":[]}") // S/A/B/C四级事件分层

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([chapterId])
}

// ─── 伏笔/承诺追踪 (Pending Commitment) ──────────────────

model PendingCommitment {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  source        String   @default("ai_inference") // outline_summary | user_intent | ai_inference | foreshadow
  sourceNodeId  String?
  priority      String   @default("medium")       // high | medium | low

  description   String                            // 承诺描述
  entityIds     Json     @default("[]")           // 涉及实体ID列表
  closureConditions Json @default("[]")           // 闭环条件JSON数组

  // 五状态机
  status             String   @default("pending")  // pending | detected | partially_fulfilled | fulfilled | voided
  fulfillmentRatio   Float    @default(0.0)
  voidReason         String?

  // 兑现记录
  fulfilledChapterId       String?
  fulfilledContentSnippet  String?
  partiallyFulfilledIds    Json     @default("[]")

  // 时间追踪
  detectedAt  DateTime?
  fulfilledAt DateTime?
  voidedAt    DateTime?

  // 完整审计链
  statusHistory Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, status])
  @@index([sourceNodeId])
}

// ─── 关键转折点 (Story Beat) —— 长期记忆索引 ──────────────

model StoryBeat {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nodeId        String
  description   String
  chapterNumber Int
  impact        String @default("minor") // "major" | "minor"

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── 故事线 (Storyline) —— 七要素事件线，主线+支线 ──────────

model Storyline {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type     String @default("side")  // "main" | "side"
  parentId String?                   // 支线挂主线
  title    String                    // 事件线名称，如"主角获得宝剑"
  order    Int @default(0)
  status   String @default("active") // "active" | "completed" | "abandoned"
  description String @default("")    // 简要说明

  // ── 七要素 ──
  desire    String @default("")  // 欲望：主角想要什么
  obstacle  String @default("")  // 阻碍：谁/什么挡着
  action    String @default("")  // 行动：主角怎么做
  result    String @default("")  // 结果：暂时成/败
  twist     String @default("")  // 意外：突然转折
  turn      String @default("")  // 转折：方向改变
  ending    String @default("")  // 结局：本事件线收束

  // 章节绑定——七要素各绑定到哪章 [{element: "desire", chapterId: "xxx", note: ""}]
  chapterBindings Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([parentId])
}

// ─── 规则 (Rule) —— 写作规则/约束 ──────────────────────────────

model Rule {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String                           // 规则名称（如"主角不杀人"）
  content   String                           // 规则正文（自然语言描述，会直接注入 prompt）
  category  String   @default("writing")     // writing / world / character / style / custom
  enabled   Boolean  @default(true)          // 是否启用
  priority  Int      @default(0)             // 优先级（越大越靠前，影响注入顺序）
  scope     String   @default("all")         // 生效范围：all / write_only / outline_only / review_only
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, enabled])
}

// ─── 全局设置 (App Settings) —— 单例，LLM 提供商 + API Key ──

model AppSettings {
  id          String   @id @default("default") // 单例，固定 key
  llmProvider String   @default("siliconflow") // openai | siliconflow | deepseek | groq | custom
  llmApiKey   String   @default("")            // API Key（明文存储，数据库本地）
  llmModel    String   @default("deepseek-ai/DeepSeek-V4-Flash")
  llmBaseUrl  String   @default("")            // 自定义 base URL（custom 提供商时使用）
  updatedAt   DateTime @updatedAt
}

// ─── 文风卡 (Style Card) —— 量化导入文本的笔触特征 ──────────

model StyleCard {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 量化句型特征
  avgSentenceLength    Float @default(25)     // 平均句子长度（字数）
  shortSentenceRatio   Float @default(0.3)   // 短句占比 (<15字)
  longSentenceRatio    Float @default(0.15)  // 长句占比 (>40字)

  // 叙事比例 (总和≈1.0)
  dialogueRatio        Float @default(0.35)  // 对话占比
  descriptionRatio     Float @default(0.25)  // 环境描写占比
  actionRatio          Float @default(0.25)  // 动作占比
  innerThoughtRatio    Float @default(0.15)  // 内心独白占比

  // 视角
  povType              String @default("third_person_limited") // 叙事视角
  narrativeDistance    String @default("medium")               // 叙事距离

  // 语气与词汇特征 (JSON)
  tonalMarkers         Json @default("{}")     // {coldness, satire, tragedy, humor, warmth...}
  lexicalFeatures      Json @default("{}")     // {classicalRatio, modernRatio, termDensity, idiomsDensity}

  // 概要说明
  styleDescription     String @default("")

  // 代表性原文样本
  sampleText           String?

  // 来源章节数
  sourceChapterCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
