generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── 项目 (Project) ────────────────────────────────────────

model Project {
  id             String   @id @default(uuid())
  name           String
  description    String   @default("")
  genre          String[]               // 类型标签
  targetWordCount Int     @default(100000)
  synopsis       String   @default("")  // 主线总纲
  toneKeywords   String[] @default([])  // 基调关键词

  globalPrompt String @default("")  // 世界书+风格卡缓存摘要——扩展角色时直接用
  authorNote   String @default("")  // 作者指令——持久化，所有生成端点统一读取
  // LLM配置 (JSON存储)
  llmConfig Json @default("{}")

  // 正则后处理规则（来自酒馆 regex 预设）
  postProcessingRules Json @default("[]")
  // 探讨模式布置配置（结构化保存，含 plotStructure/forceOriginalNames/autoGenerateStoryline 等勾选项）
  buildConfig Json?
  // 已应用创意工坊预设记录（F5 项目配置中心追踪用）：[{presetId,type,title,appliedAt}]
  appliedPresets Json @default("[]")

  // ─── 写作自动化配置（v0.33.0 新增）───
  autoFillEnabled     Boolean @default(true)   // 生成后自动填表总开关
  fillFrequency       Int     @default(1)       // 每 N 章填一次表（默认每章填，对齐计划 P1-2 每写完一章自动填表）
  skipLatestChapter  Boolean @default(false)   // 当前章也填（对齐计划 P1-2）；重 roll 由填表去重(同名转update)+selfCheck 保护，不污染表
  contextKeepChapters Int    @default(4)       // 上下文保留最近 N 章（楼层窗口大小）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? @map("deleted_at") // 软删除（回收站）；非空=在回收站

  // 确认流程：整本交付完成时间戳（null=未整体确认交付）
  confirmedAt DateTime? @map("confirmed_at")

  // Round3：智能审阅模式（Auto-Confirm）总开关，默认开启——生成完合格章自动确认，人类降级为异常处理者
  autoConfirmEnabled Boolean @default(true)
  // v1.1.0：全书智能交付自动执行开关，默认开启——全书章节全部定稿后自动完成整本交付，无需手动点「确认整本交付」
  autoDeliverEnabled Boolean @default(true)

  // 导入来源标识，用于并发幂等（N2 修复）。Postgres 多 null 不冲突，存量数据安全。
  // 值为导入源的稳定标识（如 .nfproject 原始 projectId + source 组合 hash），相同备份重复导入触发唯一冲突 → 幂等返回已存在项目。
  importSource String? @unique

  characters    CharacterCard[]
  lorebookEntries LorebookEntry[]
  loreTables    LoreTable[]
  storyNodes    StoryNode[]
  storyBranches StoryBranch[]
  chapterSummaries ChapterSummary[]
  storyBeats    StoryBeat[]
  storylines    Storyline[]
  styleCards    StyleCard[]
  rules         Rule[]
  pendingCommitments PendingCommitment[]
  gameSessions  GameSession[]
  pendingItems  PendingItem[]
}

// ─── 人物卡 (Character Card) ───────────────────────────────

model CharacterCard {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String
  aliases  String[] @default([])
  age      String   @default("未知")
  gender   String   @default("未知")
  role     String   @default("supporting") // CharacterRole枚举

  // 结构化数据 (JSON存储)
  appearance      Json @default("{}")    // CharacterAppearance
  personality     Json @default("[]")    // 结构化性格: {dominant, drive, contradiction, habits, socialMask} 或旧格式 string[]
  dialogueStyle   Json @default("{}")    // DialogueStyle
  background      String @default("")
  storyLine       String @default("")    // 角色故事线：该角色在主线中的起落弧（v1.2.0 新增，AI 填满/扩展均覆盖）
  quickImportContent String @default("")  // 快速导入原文（不做AI分析，直接抄写）
  abilities       String[] @default([])  // 能力/技能
  hiddenMotives   String[] @default([])
  relationships   Json @default("[]")    // CharacterRelationship[]

  timeline        Json @default("[]")     // TimelineEvent[] 经历时间线
  currentStatus   String @default("alive") // CharacterStatus
  arcProgress     String @default("")
  tags            String[] @default([])
  reviewStatus    String   @default("approved") // 自动填表待审：pending=待确认 approved=已确认

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─── 世界书词条 (Lorebook Entry) ───────────────────────────

model LorebookEntry {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title           String
  category        String @default("custom") // LoreCategory
  keys            String[]                  // 触发关键词
  content         String                    // 设定内容 ≤200 Token
  insertionOrder  Int @default(50)          // 0-100
  // 注入深度（酒馆 worldbook depth 0-4 迁移）：
  // 0=强效注入正文前(用户指令下方) 1=用户指令上方 2=系统上下文 3=背景设定/关键词触发(默认) 4=深层背景
  // depth<=2 强制常驻注入（不依赖关键词），depth>=3 走关键词触发路径
  depth           Int @default(3)
  enabled         Boolean @default(true)
  parentId        String?                   // 父词条
  relatedEntryIds String[] @default([])
  reviewStatus    String   @default("approved") // 自动填表待审：pending=待确认 approved=已确认

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([enabled])
}

// ─── 故事节点 (Story Node) —— 章节树 ──────────────────────

model StoryNode {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?        // 父节点（根节点=null）
  type     String         // StoryNodeType: volume/chapter/section/scene
  title    String
  order    Int @default(0)
  status   String @default("outline_only") // ContentStatus

  // 确认流程：确认定稿时间戳（null=未确认）
  confirmedAt DateTime? @map("confirmed_at")

  // 内容
  outline   String?      // 大纲
  content   String?      // 正文
  wordCount Int @default(0)

  // 分支
  branchId           String?
  isMainBranch       Boolean @default(true)

  // 元数据
  activeCharacters  String[] @default([])
  activeLoreIds     String[] @default([])
  coreConflict      String?
  settingDescription String?
  notes             String?

  // FE-N8 乐观锁：每次 PUT 成功 +1；保存时携带 expectedVersion 以检测并发冲突（手动编辑 vs AI 改写）
  editVersion       Int      @default(1)

  // FE-N6 时间线：书中世界时间标记（自由文本，如"天启三年春"／"星历2049"），用于左侧「时间线」视图按轴排序
  worldTime        String?   @map("world_time")

  // 审校 + 质量
  reviewLogs    Json @default("[]")       // ReviewLog[]
  revisionCount Int @default(0)
  qualityScore  Float?                    // 六维质量自动评分(0-100)，null=未评估

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // #123 软删除（tombstone）：删除节点仅标记 deletedAt，不物理删；可经回收站恢复/彻底清空
  deletedAt DateTime? @map("deleted_at")

  // 自引用
  parent   StoryNode?  @relation("NodeTree", fields: [parentId], references: [id])
  children StoryNode[] @relation("NodeTree")

  // 游戏会话
  gameSessions GameSession[]

  // 分支关联
  branch StoryBranch? @relation(fields: [branchId], references: [id])

  // 版本历史（BE-1）
  revisions StoryNodeRevision[]

  @@index([projectId])
  @@index([parentId])
  @@index([branchId])
  @@index([deletedAt])
}

// ─── 正文版本快照 (Story Node Revision) ──────────────────
// 每次 AI 写/重写/润色或手动保存覆盖正文前，把上一版正文快照存此处，可回滚。
model StoryNodeRevision {
  id        String   @id @default(cuid())
  nodeId    String
  node      StoryNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  projectId String
  version   Int      @default(1)            // 递增版本号（同节点内）
  content   String                          // 快照的正文全文
  wordCount Int      @default(0)
  source    String   @default("unknown")    // ai-write | ai-rewrite | ai-polish | manual | rollback | auto-fill
  summary   String?                         // 可选备注
  createdAt DateTime @default(now())

  @@index([nodeId])
  @@index([projectId])
  @@index([createdAt])
}

// ─── 故事分支 (Story Branch) ───────────────────────────────

model StoryBranch {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name            String
  description     String @default("")
  parentBranchId  String?
  forkPointNodeId String
  isActive        Boolean @default(true)

  nodes StoryNode[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── 章节摘要 (Chapter Summary) —— 中期记忆 ───────────────

model ChapterSummary {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chapterId    String
  chapterTitle String
  summary      String                    // AI压缩摘要 ≤200 Token
  keyEvents    String[] @default([])
  characterStates Json @default("[]")    // CharacterStateSnapshot[]
  eventImportances Json @default("{\"sTier\":[],\"aTier\":[],\"bTier\":[],\"cTier\":[]}") // S/A/B/C四级事件分层

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([chapterId])
}

// ─── 伏笔/承诺追踪 (Pending Commitment) ──────────────────

model PendingCommitment {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  source        String   @default("ai_inference") // outline_summary | user_intent | ai_inference | foreshadow
  sourceNodeId  String?
  priority      String   @default("medium")       // high | medium | low

  description   String                            // 承诺描述
  entityIds     Json     @default("[]")           // 涉及实体ID列表
  closureConditions Json @default("[]")           // 闭环条件JSON数组

  // 五状态机
  status             String   @default("pending")  // pending | detected | partially_fulfilled | fulfilled | voided
  fulfillmentRatio   Float    @default(0.0)
  voidReason         String?

  // 兑现记录
  fulfilledChapterId       String?
  fulfilledContentSnippet  String?
  partiallyFulfilledIds    Json     @default("[]")

  // 时间追踪
  detectedAt  DateTime?
  fulfilledAt DateTime?
  voidedAt    DateTime?

  // 完整审计链
  statusHistory Json     @default("[]")

  // 伏笔后续发展思路（作者可手填；默认由 LLM 依缝合怪多线原则生成，作为写作参考指示）
  developmentHint String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, status])
  @@index([sourceNodeId])
}

// ─── 关键转折点 (Story Beat) —— 长期记忆索引 ──────────────

model StoryBeat {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nodeId        String
  description   String
  chapterNumber Int
  impact        String @default("minor") // "major" | "minor"

  createdAt DateTime @default(now())

  @@index([projectId])
}

// ─── 故事线 (Storyline) —— 七要素事件线，主线+支线 ──────────

model Storyline {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type     String @default("side")  // "main" | "side"
  parentId String?                   // 支线挂主线
  title    String                    // 事件线名称，如"主角获得宝剑"
  order    Int @default(0)
  status   String @default("active") // "active" | "completed" | "abandoned"
  description String @default("")    // 简要说明

  // ── 七要素 ──
  desire    String @default("")  // 欲望：主角想要什么
  obstacle  String @default("")  // 阻碍：谁/什么挡着
  action    String @default("")  // 行动：主角怎么做
  result    String @default("")  // 结果：暂时成/败
  twist     String @default("")  // 意外：突然转折
  turn      String @default("")  // 转折：方向改变
  ending    String @default("")  // 结局：本事件线收束

  // 章节绑定——七要素各绑定到哪章 [{element: "desire", chapterId: "xxx", note: ""}]
  chapterBindings Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([parentId])
}

// ─── 游戏会话 (Game Session) —— 互动文本冒险 ──────────────────

model GameSession {
  id           String   @id @default(cuid())
  projectId    String
  nodeId       String   // 对应的 StoryNode（章节节点）
  status       String   @default("active") // active | completed | abandoned
  currentRound Int      @default(0)
  totalWords   Int      @default(0)
  maxWords     Int      @default(3000)     // 单章游戏模式字数上限
  plotProgress Int      @default(0)        // 情节进度 0-100
  // IMP-001 快照：作者进入游戏前一刻的写作原正文（不含任何游戏导出轮次）。
  // 跨 resetGameSession 持续复用，避免二次「结束并导出」把上一次导出的全量内容当成原正文再次前置堆叠。
  originalContentSnapshot String @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  node    StoryNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  states  GameState[]

  @@index([projectId])
  @@index([nodeId])
  @@unique([projectId, nodeId])  // 一个章节同一时间只有一个活跃游戏会话
}

// ─── 游戏状态快照 (Game State) —— 每轮一次 ──────────────────

model GameState {
  id           String   @id @default(cuid())
  sessionId    String
  round        Int
  playerAction String                    // 用户选择的行动文本
  narrative    String   @default("")     // AI 生成的叙事正文
  options      Json     @default("[]")   // 下一轮选项: string[]
  entities     Json     @default("[]")   // 追踪实体: {name, type, desc}[]
  items        Json     @default("[]")   // 背包物品: {name, qty, source}[]
  plotProgress Int      @default(0)
  wordCount    Int      @default(0)
  createdAt    DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@unique([sessionId, round]) // 阿游 P1-2：并发/重试写重复轮次快照的数据库层兜底，消除对账歧义
}

// ─── 规则 (Rule) —— 写作规则/约束 ──────────────────────────────

model Rule {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String                           // 规则名称（如"主角不杀人"）
  content   String                           // 规则正文（自然语言描述，会直接注入 prompt）
  category  String   @default("writing")     // writing / world / character / style / custom
  enabled   Boolean  @default(true)          // 是否启用
  priority  Int      @default(0)             // 优先级（越大越靠前，影响注入顺序）
  scope     String   @default("all")         // 生效范围：all / write_only / outline_only / review_only

  // ── 冲突裁决系统 ──
  scopeType       String   @default("global") // global | volume | chapter_range | event_type | character_scene | conditional
  specificityScore Int     @default(1)        // 特异性分（global=1 → conditional=6）
  scopeConfig     Json     @default("{}")     // 作用域配置（chapter range/条件等）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, enabled])
  @@index([projectId, enabled, priority])
}

// ─── 全局设置 (App Settings) —— 单例，LLM 提供商 + API Key ──

model AppSettings {
  id          String   @id @default("default") // 单例，固定 key
  llmProvider String   @default("siliconflow") // openai | siliconflow | deepseek | groq | custom
  llmApiKey   String   @default("")            // API Key（明文存储，数据库本地）
  llmModel    String   @default("deepseek-ai/DeepSeek-V4-Flash")
  llmBaseUrl  String   @default("")            // 自定义 base URL（custom 提供商时使用）
  updatedAt   DateTime @updatedAt
}

// ─── 文风卡 (Style Card) —— 量化导入文本的笔触特征 ──────────

model StyleCard {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 量化句型特征
  avgSentenceLength    Float @default(25)     // 平均句子长度（字数）
  shortSentenceRatio   Float @default(0.3)   // 短句占比 (<15字)
  longSentenceRatio    Float @default(0.15)  // 长句占比 (>40字)

  // 叙事比例 (总和≈1.0)
  dialogueRatio        Float @default(0.35)  // 对话占比
  descriptionRatio     Float @default(0.25)  // 环境描写占比
  actionRatio          Float @default(0.25)  // 动作占比
  innerThoughtRatio    Float @default(0.15)  // 内心独白占比

  // 视角
  povType              String @default("third_person_limited") // 叙事视角
  narrativeDistance    String @default("medium")               // 叙事距离

  // 语气与词汇特征 (JSON)
  tonalMarkers         Json @default("{}")     // {coldness, satire, tragedy, humor, warmth...}
  lexicalFeatures      Json @default("{}")     // {classicalRatio, modernRatio, termDensity, idiomsDensity}

  // 概要说明
  styleDescription     String @default("")

  // 代表性原文样本
  sampleText           String?

  // 来源章节数
  sourceChapterCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─── 拆书任务 (Dissection Task) —— 整本小说导入+多维拆解 ──

model DissectionTask {
  id            String   @id @default(uuid())
  taskName      String                     // 用户命名的任务名
  bookName      String                     // 原书名称
  bookAuthor    String   @default("")      // 原书作者
  originalText  String   @db.Text          // 上传的原始文本（全文）
  depth         String   @default("standard") // quick | standard | deep
  extractChapterSummaries Boolean @default(false) // 是否逐章提取摘要
  status        String   @default("pending") // pending | chunking | extracting | completed | failed
  progress      Float    @default(0)       // 0-100
  totalChapters Int      @default(0)
  completedChapters Int   @default(0)
  dimensions    Json     @default("{}")    // 15维度数据: { worldview: {...}, characters: [...], ... }
  chapterList   Json     @default("[]")    // [{index, title, startPos, endPos}]
  error         String?                    // 错误信息
  convertedToProjectId String?             // 转为项目后的ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── 导入任务 (Import Task) —— 多格式书稿导入+AI提取异步化 ──

model ImportTask {
  id          String   @id @default(uuid())
  projectId   String   @default("")
  importMode  String   @default("settings") // settings | characters | quick
  status      String   @default("pending")  // pending | parsing | completed | failed
  progress    Float    @default(0)          // 0-100
  result      Json?                        // 完成后写入: { characters, lore, style }
  error       String?                      // 错误信息
  rawTextLen  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// ─── 后台任务 (FillTask) —— 一键追评填表 / 批量写作 异步化（v1.4.0）──
// 用户点「一键追评」后立即返回 taskId，后台 fire-and-forget 逐章执行，
// 前端 2-3s 轮询 GET /api/babylore/fill-task/[taskId] 展示进度；关页面任务继续（本地进程常驻）。

model FillTask {
  id        String   @id @default(uuid())
  projectId String
  taskType  String   @default("fill") // fill | batchWrite
  status    String   @default("pending") // pending | running | completed | failed
  progress  Float    @default(0)          // 0-100
  total     Int      @default(0)
  done      Int      @default(0)
  failed    Int      @default(0)
  result    Json?                         // 完成后写入: { applied, operations, createdChars, createdLore, skipped }
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── 导入提交幂等锁 (Import Commit Lock) ───────────────
// 替代进程内存 Map：基于 (projectId, nodeId) 唯一约束实现跨实例幂等。
// commit 为项目级提交，nodeId 用占位键；并发提交同一项目触发 P2002 唯一冲突 → 视为重复跳过（409）。

model ImportCommitLock {
  id        String   @id @default(uuid())
  projectId String
  nodeId    String   @default("__commit__") // 锁粒度键；项目级提交用占位，未来可按节点细化
  createdAt DateTime @default(now())

  @@unique([projectId, nodeId])
  @@index([projectId])
}

// ─── 待兑现事项追踪 (Pending Item) ──────────────────────

model PendingItem {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  itemType         String   // foreshadow_recovery / character_arc / plot_turn / user_note
  content          String   @db.Text
  priority         String   @default("medium") // high / medium / low
  status           String   @default("pending") // pending / fulfilled / discarded
  source           String   @default("user")    // user / distillation / outline
  sourceNodeId     String?
  deadlineChapter  Int?
  fulfilledAt      DateTime?
  fulfilledNodeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
}

// ─── 结构化表格 (Lore Table) —— 宝宝流数据库内核 ────────
// 世界书升级为结构化表格：每行是一条例证数据，由 LLM 自动填表抽取。
// JSON 行操作协议等价于宝宝流 SQL 模式（insert/update/delete），但在应用层用 JS 落地，避免动态 SQL。

model LoreTable {
  id        String @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name     String                    // 表名，如「妃嫔居住建筑表」
  key      String                    // 英文标识，如 woman_live
  note     String @default("")       // 表格说明（每列含义）
  category String @default("custom") // person|place|item|attribute|timeline|custom
  marker   String @default("")       // 数据隔离标记，如 [ACU-{projectId}]

  columns  Json @default("[]")       // [{key,label,type}]  例 [{key:"name",label:"妃嫔名称",type:"text"}]
  rows     Json @default("[]")       // [{row_id, ...列值}]  例 [{row_id:1,name:"甄嬛",live:"碎玉轩",status:"已入住",note:"初入宫"}]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([key])
}

// ─── 自动填表批次溯源（v1.6.19 #6 修复）──────────────
// 记录每次「写章/续写/微调后自动填表」实际新增了哪些结构化表格行（row_id 列表），
// 供撤销章节时精确清理该章自动填入的表格行，避免撤销正文后表格行残留。
// 记录 insert 类新增行（insertedRowIds）+ update 类被改写既有行的更新前整行快照（updatedRowsBefore），
// 供撤销章节时既删新增行、又还原被 update 的既有行（v1.6.23 F2 修复）。
model BabyloreFillBatch {
  id              String   @id @default(uuid())
  projectId       String
  nodeId          String           // 来源章节节点 ID（撤销的精确锚点）
  loreTableId     String           // 受影响的结构化表格
  insertedRowIds  Json    @default("[]") // 本次填表实际 insert 的 row_id 数组
  updatedRowsBefore Json @default("{}") // 本次填表实际 update 的 row_id -> 更新前整行快照
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([nodeId])
  @@index([loreTableId])
}

// ─── 预设 (Preset) —— 创意工坊/共创社区资产 ─────────────
// 把「参考资料本身就是个预设」实体化：表格模板预设 + 剧情推进预设 + 文风 + 世界观 + 角色卡
// 用户可在创意工坊上传/共享/Fork 这些预设（免费、非商业）。

model Preset {
  id            String   @id @default(uuid())
  type          String                    // table_template | story_progression | style | worldview | character | regex | lorebook | api_config
  title         String
  description   String @default("")
  content       Json @default("{}")       // 预设载荷（结构随 type 而定）
  author        String @default("系统")
  tags          String[] @default([])     // 题材标签：玄幻/言情/科幻...
  downloads     Int @default(0)
  isPublic      Boolean @default(true)
  isBuiltin     Boolean @default(false)   // 系统内置示范预设
  forkedFromId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([isPublic])
  @@index([tags])
}

// ─── LLM 调用日志（成本看板数据源）─────────────────────
// 记录每次真实 LLM 调用的 token 用量与估算成本，供统计面板「AI 成本看板」聚合展示。
// 仅记录 v0.46.20 之后产生的调用；历史调用无数据（此前未落库）。

model LlmCallLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  projectId       String? // 关联项目（部分调用无项目上下文则为空）
  model           String // 实际调用模型名（故障转移时记录备用模型）
  role            String   @default("general") // architect/writer/reviewer/summarize/extractor/general
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  totalTokens     Int      @default(0)
  estimatedCost   Float    @default(0) // 估算成本（美元），按内置价格表计算
  baseURL         String? // 实际调用 Base URL（故障转移溯源）
  isFallback      Boolean  @default(false) // 是否经故障转移备用模型完成
  durationMs      Int?     // 单次 LLM 调用总耗时（毫秒）——生成延迟硬指标数据源
  firstTokenMs    Int?     // 首 token 延迟 / TTFB（毫秒），流式场景记录到首个正文 token 的时间

  @@index([createdAt])
  @@index([projectId])
  @@index([model])
  @@index([role])
}
